/**
 * Unified RTS Agents web deployment: the Cloudflare Worker proxies /api/* to
 * providers and Workers Assets serves the shared Vite build (dist/renderer)
 * with single-page-application fallback.
 *
 * Production hostname: https://agents.ajfrio.com
 * Requires the ajfrio.com zone to live on the same Cloudflare account as
 * CLOUDFLARE_API_TOKEN. The workers.dev URL remains available as a fallback.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rts-agents-webapp",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-27",
  "workers_dev": true,
  // Cloudflare Workers Builds / `wrangler deploy` must produce dist/renderer
  // (Vite outDir) before the assets upload. GitHub Actions used to run
  // `npm run build` separately; dashboard deploys did not, and failed with
  // "assets.directory does not exist".
  "build": {
    "command": "npm run build",
    "cwd": ".",
    "watch_dir": ["src/renderer", "worker"],
  },
  "routes": [
    {
      "pattern": "agents.ajfrio.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "dist/renderer",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
}
